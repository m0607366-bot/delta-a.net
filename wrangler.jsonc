{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "delta-a-net",
	"compatibility_date": "2026-02-24",
	// 本番ドメイン（Cloudflareのカスタムドメイン）。仮のアドレス（workers.dev）も残す
	"workers_dev": true,
	"routes": [{ "pattern": "delta-a.net", "custom_domain": true }],
	// WordPressの表示をそのまま写した静的ファイルだけのサイト
	"assets": {
		"directory": "./site",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
